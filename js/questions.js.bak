  { c:"tecnologia", q:"¿Para qué sirve principalmente una GPU?", o:["Guardar archivos","Procesar gráficos en paralelo","Administrar la red","Enfriar la CPU"], a:1,
    e:"Es un procesador masivamente paralelo; por eso también se usa para IA." },

  { c:"tecnologia", q:"¿Quién creó el núcleo Linux?", o:["Richard Stallman","Linus Torvalds","Dennis Ritchie","Ken Thompson"], a:1,
    e:"Torvalds lo publicó en 1991, con 21 años, como proyecto personal." },

  { c:"tecnologia", q:"¿Qué significa que un programa sea «open source»?", o:["Que es gratis","Que su código se puede leer y modificar","Que no tiene errores","Que corre en la nube"], a:1,
    e:"El código está disponible bajo una licencia que permite usarlo, estudiarlo y modificarlo. Gratis y libre no son lo mismo." },

  { c:"tecnologia", q:"¿Cuál de estos es un sistema de archivos típico de Linux?", o:["NTFS","APFS","ext4","FAT32"], a:2,
    e:"ext4 es el estándar en la mayoría de distribuciones. NTFS es de Windows y APFS de macOS." },

  { c:"tecnologia", q:"¿Qué caracteriza a la memoria RAM?", o:["Guarda datos para siempre","Es volátil y rápida","Solo sirve para gráficos","Está en el disco duro"], a:1,
    e:"Pierde el contenido al apagarse; su ventaja es la velocidad de acceso." },

  { c:"tecnologia", q:"¿Qué servicio traduce un nombre de dominio a una dirección IP?", o:["DHCP","DNS","FTP","SMTP"], a:1,
    e:"El DNS es la agenda que convierte «ejemplo.com» en una IP." },

  { c:"tecnologia", q:"¿Qué es un «bug» en software?", o:["Una mejora","Un error en el funcionamiento","Un tipo de licencia","Un virus"], a:1,
    e:"Un defecto que hace que el programa se comporte distinto a lo esperado." },

  { c:"tecnologia", q:"¿Qué mide la unidad llamada «hercio»?", o:["La memoria","La frecuencia","La energía","El tamaño de pantalla"], a:1,
    e:"Un hercio es un ciclo por segundo; se usa para relojes y ondas." },

  { c:"tecnologia", q:"¿En qué empresa nació el lenguaje Rust?", o:["Google","Mozilla","Microsoft","Meta"], a:1,
    e:"Mozilla lo impulsó desde 2010 como lenguaje seguro para sistemas." }
